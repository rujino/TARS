# ==============================================================================
# TARS Application Configuration Template (.env.example)
# ==============================================================================

# [1. 필수 API 키 & 보안 설정]
# Google Gemini API Key (클라우드 고지능 추론 및 툴 호출 전담)
TARS_GEMINI_API_KEY=your_gemini_api_key_here
# Gemini 모델 식별자 (예: gemini-2.0-flash, gemini-2.0-pro-exp-02-05, gemini-1.5-flash)
TARS_GEMINI_MODEL_NAME=gemini-2.0-flash

# JWT 토큰 서명용 시크릿 키 (최소 32자 이상)
TARS_JWT_SECRET_KEY=tars-insecure-dev-secret-key-32-chars-minimum!!
TARS_JWT_ALGORITHM=HS256
TARS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080


# [2. 외부 추론 엔진 (로컬 SLM / llama.cpp)]
# 로컬 llama.cpp (OpenAI 호환 API 서버) 엔드포인트 URL
TARS_LLAMACPP_BASE_URL=http://localhost:8080/v1
TARS_LLAMACPP_MODEL_NAME=default
TARS_LLAMACPP_TIMEOUT_MS=3000


# [3. 데이터베이스 & 스토리지 설정]
# 기본 SQLite 비동기 연결 (PostgreSQL 전환 시: postgresql+asyncpg://user:pass@host:5432/dbname)
TARS_DATABASE_URL=sqlite+aiosqlite:///./tars.db
TARS_DB_ECHO=false

# 사용자별 OKF 마크다운 파일 저장 루트 디렉터리
TARS_STORAGE_DIR=./storage


# [4. TARS 페르소나 기본 파라미터]
# 유머 지수 (0.0 ~ 1.0) - 인터스텔라 TARS 기본값 90%
TARS_DEFAULT_HUMOR_LEVEL=0.90

# 솔직함 지수 (0.0 ~ 1.0) - 인터스텔라 TARS 기본값 95%
TARS_DEFAULT_HONESTY_LEVEL=0.95

# 기본 동작 모드 (companion: 일상 동반자 모드, work: 업무 보조 모드)
TARS_DEFAULT_MODE=companion


# [5. 동적 슬라이서 토큰 예산]
TARS_SLICER_DEFAULT_TOKEN_BUDGET=1500


# [6. 실행 환경 설정]
TARS_APP_NAME=TARS
TARS_ENVIRONMENT=development
TARS_DEBUG=false
