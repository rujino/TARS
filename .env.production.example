# ==============================================================================
# TARS Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# Instructions:
# 1. Copy this file: cp .env.production.example .env
# 2. Fill in all required secrets (JWT, PostgreSQL, Gemini API Key, Domain).
# ==============================================================================

# [1. Core Application Settings]
TARS_APP_NAME=TARS
TARS_ENVIRONMENT=production
TARS_DEBUG=false

# [2. Security & Authentication]
# Generate a cryptographically secure 64-character hex secret: openssl rand -hex 32
TARS_JWT_SECRET_KEY=replace_with_a_super_secure_random_64_character_hex_string_here
TARS_JWT_ALGORITHM=HS256
# 7 days lifetime in minutes (10080)
TARS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# [3. Production Database (PostgreSQL 16)]
POSTGRES_USER=tars_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_DB=tars_db
POSTGRES_PORT=5432

# Async SQLAlchemy PostgreSQL Connection URL
TARS_DATABASE_URL=postgresql+asyncpg://tars_admin:replace_with_strong_database_password_here@tars-db:5432/tars_db
TARS_DB_ECHO=false

# [4. Domain, SSL & Certbot Configuration]
# Your public domain or DDNS hostname (e.g. tars.duckdns.org or yourdomain.com)
TARS_DOMAIN=tars.yourdomain.com
# Contact email for Let's Encrypt certificate renewal notices
CERTBOT_EMAIL=admin@yourdomain.com
# Set to 1 for testing (avoids Let's Encrypt rate limits), set to 0 for production
CERTBOT_STAGING=0

# Host Port Mappings
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# [5. AI Inference & LLM Providers]
# Google Gemini API Key (Required for high-intelligence user-facing responses and tool execution)
TARS_GEMINI_API_KEY=your_gemini_api_key_here
TARS_GEMINI_MODEL_NAME=gemini-2.0-flash

# Local SLM (llama.cpp) Host Endpoint (Optional internal preprocessing)
# On Linux / Mac Docker: http://host.docker.internal:8080/v1
TARS_LLAMACPP_BASE_URL=http://host.docker.internal:8080/v1
TARS_LLAMACPP_MODEL_NAME=default
TARS_LLAMACPP_TIMEOUT_MS=3000

# [6. Storage & Persona Defaults]
TARS_STORAGE_DIR=/app/storage
TARS_DEFAULT_HUMOR_LEVEL=0.90
TARS_DEFAULT_HONESTY_LEVEL=0.95
TARS_DEFAULT_MODE=companion
TARS_SLICER_DEFAULT_TOKEN_BUDGET=1500

# [7. External Integrations (Optional / Mock)]
TARS_GOOGLE_MOCK_MODE=true
TARS_GOOGLE_CLIENT_ID=
TARS_GOOGLE_CLIENT_SECRET=
TARS_GOOGLE_REFRESH_TOKEN=
TARS_GOOGLE_CALENDAR_ID=primary
