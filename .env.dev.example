# ==============================================================================
# TARS Local Development Environment Variables (.env.dev.example)
# 복사하여 .env 파일로 생성 후 사용하세요: cp .env.dev.example .env
# ==============================================================================

# Application General Settings
TARS_ENVIRONMENT=development
TARS_DEBUG=true
TARS_APP_NAME=TARS

# Storage Settings (local or s3)
# - local: 로컬 파일 시스템 (./storage) 직접 사용
# - s3: SeaweedFS / S3 호환 오브젝트 스토리지 사용 (docker-compose.dev.yml의 seaweedfs 서비스)
TARS_STORAGE_BACKEND=s3
TARS_STORAGE_DIR=./storage
TARS_S3_ENDPOINT_URL=http://localhost:8333
TARS_S3_BUCKET_NAME=tars-okf
TARS_S3_ASSETS_BUCKET_NAME=tars-assets
TARS_S3_REGION=us-east-1
TARS_S3_ACCESS_KEY=tars-admin-access-key
TARS_S3_SECRET_KEY=tars-admin-secret-key-at-least-16-chars

# Database (PostgreSQL)
TARS_DATABASE_URL=postgresql+asyncpg://tarsuser:tarspassword@localhost:5432/tars
TARS_DB_ECHO=false

# Redis Backplane & Turn Lock
TARS_REDIS_ENABLED=true
TARS_REDIS_URL=redis://localhost:6379/0

# JWT Authentication
TARS_JWT_SECRET_KEY=tars-insecure-dev-secret-key-32-chars-minimum!!
TARS_JWT_ALGORITHM=HS256
TARS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External LLM Endpoints
TARS_GEMINI_API_KEY=your_gemini_api_key_here
TARS_GEMINI_MODEL_NAME=gemini-3.7-flash

# Langfuse Observability Settings
# 1. docker compose -f docker-compose.dev.yml up -d 로 로컬 Langfuse 컨테이너 실행
# 2. http://localhost:3000 접속 후 계정 생성 및 프로젝트 생성
# 3. Settings > API Keys 에서 생성된 Public Key(pk-lf-...)와 Secret Key(sk-lf-...)를 아래에 입력
TARS_LANGFUSE_ENABLED=true
TARS_LANGFUSE_HOST=http://localhost:3000
TARS_LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
TARS_LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
